# Never commit real API keys. Keep Supabase service credentials on the server only.
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_SITE_URL=https://vitni.cc
# Resend sends partner enquiries; verify this sender domain in Resend first.
RESEND_API_KEY=
PARTNER_INQUIRY_FROM_EMAIL="Vitni <partnerships@vitni.cc>"
# Add only after approval in Amazon Associates; links stay untracked without it.
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=
# Paddle one-time consumer checkout. Create matching one-time prices for €2.49 (1 guide)
# and €9.99 (5 guides), then add their Paddle price IDs here. Keep API/signing secrets server-only.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_REPAIR_GUIDE_SINGLE=
PADDLE_PRICE_REPAIR_GUIDE_FIVE=
PADDLE_CLIENT_TOKEN=
# Optional GA4 web stream ID (G-...). Analytics stays off until a visitor opts in.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
